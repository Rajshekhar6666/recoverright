# RecoverRight Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# -----------------------------------------------------------------------------
# LLM Inference Credentials & Models
# -----------------------------------------------------------------------------
# Groq API Key for dual extraction pipeline
GROQ_API_KEY=your_groq_api_key_here

# Extractor Model A (Primary Extractor)
MODEL_A=openai/gpt-oss-120b

# Extractor Model B (Secondary Independent Verifier)
MODEL_B=qwen/qwen3.8-27b

# -----------------------------------------------------------------------------
# Application & Storage Paths
# -----------------------------------------------------------------------------
# Directory where patient runs and clinical audit trails are stored
RR_RUNS_DIR=./data/runs

# Directory where LLM extraction cache is persisted
RR_CACHE_DIR=./data/cache

# -----------------------------------------------------------------------------
# Network & Service Endpoints
# -----------------------------------------------------------------------------
# FastAPI API Server port
API_PORT=8000

# Next.js Web Frontend port
WEB_PORT=3000

# Base URL used by the web client to reach the API server
NEXT_PUBLIC_API_URL=http://localhost:8000
