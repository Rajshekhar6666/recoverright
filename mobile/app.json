{
  "expo": {
    "name": "RecoverRight Patient Companion",
    "slug": "recoverright-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.recoverright.companion",
      "infoPlist": {
        "NSCalendarsUsageDescription": "RecoverRight needs access to your calendar to automatically schedule and remind you of your follow-up clinical appointments.",
        "NSMicrophoneUsageDescription": "RecoverRight uses the microphone to listen for emergency calls for help (such as 'help' or 'बचाओ') and enable hands-free voice check-ins with your care team.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "voip"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "org.recoverright.companion",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow RecoverRight to sync clinical follow-up visits to your calendar."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB",
          "sounds": [
            "./assets/alarm_chime.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3d1f5b66-34c9-431d-97fd-3e98dce3d4f9"
      }
    }
  }
}
